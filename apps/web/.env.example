# Empty uses same-origin /api; Vite dev proxy targets http://127.0.0.1:8000.
# Set an absolute origin for a direct backend connection (requires backend CORS).
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=10000
# Safety cap only; align with the API's configured clip duration limit.
# The user can end capture earlier. No capture begins on camera enable.
VITE_MAX_CAPTURE_MS=5000
